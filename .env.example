# Copy to .env.local for development. Never commit real values.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
VINIFY_INDEXABLE=false

# Use an isolated PostgreSQL database for preview and development.
# `npm run dev:db` starts a local embedded database and will create this file if it is missing.
# Local example: postgresql://postgres@127.0.0.1:55432/vinify?schema=public
# Never put a production (Neon) connection string in a local env file.
DATABASE_URL=

# 32 random bytes encoded in base64. Required to write or read encrypted supplier keys.
API_ENCRYPTION_KEY=

# Stripe test mode by default. Commerce also requires a registered licensed adapter.
COMMERCE_ENABLED=false
STRIPE_LIVE_MODE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Leave unset until a licensed supplier has been contracted and its adapter registered.
HISTORY_PROVIDER=
HISTORY_PROVIDER_API_KEY=
VINIFY_ALLOW_SAMPLE_PROVIDER=false
